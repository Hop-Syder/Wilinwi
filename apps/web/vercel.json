{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "framework": "nextjs",

  "buildCommand": "cd ../.. && pnpm install --frozen-lockfile && pnpm --filter @wilinwi/db build && pnpm --filter @wilinwi/types build && pnpm --filter @wilinwi/ui build && pnpm --filter web build",
  "outputDirectory": ".next",
  "installCommand": "echo 'pnpm install géré par buildCommand'",

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}

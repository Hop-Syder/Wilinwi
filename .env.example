# ==============================================================================
# 🌐 VARIABLES FRONTEND (apps/web) - NEXT.JS
# ==============================================================================
# Variables exposées publiquement au navigateur (doivent commencer par NEXT_PUBLIC_)

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_API_URL=https://wilinwi-api.up.railway.app


# ==============================================================================
# ⚙️ VARIABLES BACKEND (apps/api) - NESTJS & PRISMA
# ==============================================================================
# Variables sécurisées, uniquement accessibles côté serveur

# ─── API NestJS ───
API_PORT=4000

# ─── Base de données (Prisma) ───
# Connexion poolée (mode session port 5432) pour l'app
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:[YOUR-PASSWORD]@aws-1-REGION.pooler.supabase.com:5432/postgres
# Connexion directe (mode session port 5432) pour les migrations
DIRECT_URL=postgresql://postgres.YOUR-PROJECT:[YOUR-PASSWORD]@aws-1-REGION.pooler.supabase.com:5432/postgres

# ─── Supabase (Admin & Auth) ───
# Récupérés dans le dashboard Supabase : Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Secret de signature des JWT (Project Settings → API → JWT Secret)
SUPABASE_JWT_SECRET=your-jwt-secret

# ─── Console Platform Super-Admin ───
# Liste des emails super-administrateurs plateforme séparés par des virgules
PLATFORM_ADMIN_EMAILS=daoudaabassichristian@gmail.com,admin@wilinwi.com

# ─── Sécurité (CORS) ───
# Origines front autorisées, séparées par des virgules (PROD : à définir !).
# Laisser vide en local = permissif. Ex. prod :
# CORS_ORIGINS=https://app.wilinwi.com,https://wilinwi.vercel.app
CORS_ORIGINS=

# URL de base du frontend, pour le lien d'invitation par email (→ /set-password).
# Local : http://localhost:3000 (défaut). Prod : l'URL Vercel de l'app.
# WEB_BASE_URL=https://app.wilinwi.com
WEB_BASE_URL=

{
  "name": "wilinwi",
  "version": "0.1.0",
  "private": true,
  "description": "Wilinwi — Le système d'exploitation du commerce africain (monorepo)",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @wilinwi/db generate",
    "db:migrate": "pnpm --filter @wilinwi/db migrate",
    "db:seed": "pnpm --filter @wilinwi/db seed",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "headers:add": "node scripts/add-headers.js"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.5.0",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild"
    ]
  }
}

// Wilinwi — schéma de données MVP1 « Le Socle »
// Monolithe modulaire, multi-tenant. Toutes les tables (sauf Tenant) portent
// un tenantId et sont protégées par RLS (cf. prisma/migrations/.../rls.sql).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────── Enums ───────────────────────────────

enum Role {
  OWNER
  MANAGER
  SELLER
  CASHIER
  DELIVERY
}

enum Plan {
  STARTER
  PRO
  BUSINESS
  ENTERPRISE
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

/// Configuration tarifaire & limites par plan, pilotable depuis la console super-admin
/// (Lot 2.3). Table de RÉFÉRENCE globale (non multi-tenant) : lue au runtime par tous,
/// écrite uniquement par le super-admin via une fonction SECURITY DEFINER.
/// Convention : une limite à `-1` signifie « illimité » (Infinity n'est pas stockable).
/// Prix en FCFA (entier) ; `null` = « sur devis » (ex. ENTERPRISE), `0` = gratuit (STARTER).
model PlanConfig {
  plan              Plan      @id
  label             String
  priceMonthly      Int?      @map("price_monthly")
  priceYearly       Int?      @map("price_yearly")
  maxUsers          Int       @default(-1) @map("max_users")
  maxEtablissements Int       @default(-1) @map("max_etablissements")
  maxDevices        Int       @default(-1) @map("max_devices")
  maxPhotos         Int       @default(0) @map("max_photos")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("plan_configs")
}

// Tarif mensuel d'une infrastructure par établissement ACTIF (Option C — TDR §18.1).
// Table GLOBALE (pas de tenant_id, PAS de RLS — comme plan_configs), éditée par la
// console super-admin. RETAIL/SERVICE = 0 (inclus) ; FOOD/HEALTH/WHOLESALE = surcoût.
model InfraPricing {
  infrastructure EtablissementInfrastructure @id
  priceMonthly   Int                         @default(0) @map("price_monthly")
  updatedAt      DateTime                    @updatedAt @map("updated_at")

  @@map("infra_pricing")
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELLED
}

// Type d'établissement (lieu physique d'exploitation d'une entreprise).
enum EtablissementType {
  BOUTIQUE
  SUPERMARCHE
  PHARMACIE
  RESTAURANT
  ENTREPOT
  AGENCE
  BUREAU
  USINE
}

// Gravité d'une alerte d'audit (TDR §18.2 — anomalies détectées a posteriori).
enum AuditAlertSeverity {
  INFO
  WARNING
  CRITICAL
}

// Infrastructure métier d'un établissement : pilote les capacités fonctionnelles
// (modules, POS, règles de stock) — coexiste avec `type` (nature physique). ADR-001/002.
enum EtablissementInfrastructure {
  RETAIL
  FOOD
  HEALTH
  SERVICE
  WHOLESALE
}

// Comportement stock/vente d'un produit (ADR-003).
enum ProductType {
  STANDARD // stock direct décrémenté à la vente
  BATCHED // stock par lots (FEFO, péremption) — Milestone 4
  MANUFACTURED // produit fabriqué : pas de stock direct (recettes — Milestone 3)
  SERVICE // prestation immatérielle : aucun stock
}

// Politique de stock appliquée à la vente.
enum StockPolicy {
  STRICT // bloque si stock insuffisant
  ALLOW_NEGATIVE // autorise le stock négatif avec alerte
  NO_STOCK // ignore le stock
  RECIPE_BASED // décrémente les composants (recette)
}

// Nature de l'unité de base d'un produit.
enum UnitKind {
  UNIT
  WEIGHT
  VOLUME
  PACKAGE
  TIME
}

enum StockMovementType {
  IN
  OUT
  ADJUST
}

enum InventoryStatus {
  OPEN
  VALIDATED
  CANCELLED
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY // générique : MoMo, Moov, Celtiis, Orange… (regroupés)
  BANK_TRANSFER
  CREDIT
  INSTALLMENT
}

// NOTE : PENDING_APPROVAL a été SUPPRIMÉ — la vente sous le plancher est
// strictement refusée (anti-fraude absolu), aucun flux d'approbation.
enum SaleStatus {
  COMPLETED
  PENDING_PAYMENT // acompte / crédit en cours
  CANCELLED
}

enum InstallmentStatus {
  PENDING
  PARTIAL
  SETTLED
  OVERDUE
}

// ─────────────────────────────── ADN ─────────────────────────────────

model Tenant {
  id                 String             @id @default(uuid()) @db.Uuid
  nom                String
  /// Localisation du siège (onboarding) : tant que `pays` est nul, le Hub affiche
  /// le pop-up bloquant « Pays & Ville » au propriétaire.
  pays               String?
  ville              String?
  plan               Plan               @default(STARTER)
  subscriptionStatus SubscriptionStatus @default(TRIALING) @map("subscription_status")
  /// Date de passage en impayé (PAST_DUE) → pilote la relance progressive (J+0/J+3/J+7/J+30).
  pastDueSince       DateTime?          @map("past_due_since")
  /// Échéance du prochain règlement d'abonnement (null = facturation non configurée).
  subscriptionDueDate DateTime?         @map("subscription_due_date")
  /// Cycle de facturation (mensuel/annuel) — sert à reporter l'échéance au paiement.
  billingCycle       BillingCycle       @default(MONTHLY) @map("billing_cycle")
  /// Modules premium activés « à la carte » pour cette entreprise, en plus de ceux
  /// inclus dans son plan (Lot 2.4). Valeurs = clés de MODULES. Neutralisés si impayé (J+7).
  moduleAddons       String[]           @default([]) @map("module_addons")
  /// Entreprise INTERNE (compte super-admin Nexus, démo…) : exclue des vues, métriques
  /// et funnel de la console plateforme pour ne pas polluer les chiffres clients.
  internal           Boolean            @default(false)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  users           User[]
  products        Product[]
  stockMovements  StockMovement[]
  inventories     Inventory[]
  sales           Sale[]
  saleInstallments SaleInstallment[]
  clients         Client[]
  clientPayments  ClientPayment[]
  cashMovements   CashMovement[]
  cashCloses      CashClose[]
  activityLogs    ActivityLog[]
  etablissements      Etablissement[]
  userEtablissements  UserEtablissement[]
  suppliers       Supplier[]
  purchaseOrders  PurchaseOrder[]
  supplierPayments SupplierPayment[]
  productStocks   ProductStock[]
  dispatchOrders  DispatchOrder[]
  notifications   Notification[]
  auditAlerts     AuditAlert[]
  productRecipes  ProductRecipe[]
  recipeItems     RecipeItem[]
  foodTables      FoodTable[]

  @@map("tenants")
}

// ─────────────────── Établissements (lieux physiques) ───────────────────
// Une Entreprise (= Tenant) possède plusieurs établissements. Les données
// transactionnelles (ventes, mouvements de stock, trésorerie, inventaires)
// sont rattachées à un établissement. Le catalogue produits et les clients
// restent au niveau Entreprise (Phase 1).

model Etablissement {
  id             String                      @id @default(uuid()) @db.Uuid
  tenantId       String                      @map("tenant_id") @db.Uuid
  nom            String
  type           EtablissementType           @default(BOUTIQUE)
  infrastructure EtablissementInfrastructure @default(RETAIL)
  ville          String?
  adresse        String?
  telephone      String?
  // Préférences locales par établissement (champs seuls pour l'instant, logique i18n à venir).
  langue         String?                     @default("fr")
  devise         String?                     @default("XOF")
  timezone       String?
  actif          Boolean                     @default(true)
  createdAt      DateTime                    @default(now()) @map("created_at")
  updatedAt      DateTime                    @updatedAt @map("updated_at")

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userAccess     UserEtablissement[]
  sales          Sale[]
  stockMovements StockMovement[]
  cashMovements  CashMovement[]
  cashCloses     CashClose[]
  inventories    Inventory[]
  activityLogs   ActivityLog[]
  purchaseOrders PurchaseOrder[]
  productStocks  ProductStock[]
  dispatchSources      DispatchOrder[] @relation("DispatchSource")
  dispatchDestinations DispatchOrder[] @relation("DispatchDestination")
  foodTables           FoodTable[]

  @@index([tenantId])
  @@index([tenantId, infrastructure])
  @@map("etablissements")
}

// Accès d'un employé à un établissement (un employé peut accéder à 0..N).
model UserEtablissement {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  etablissementId String   @map("etablissement_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  etablissement Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)

  @@unique([userId, etablissementId])
  @@index([tenantId])
  @@index([etablissementId])
  @@map("user_etablissements")
}

// ─────────────────────── Journal d'activité — Audit (MVP2) ───────────────────────

model ActivityLog {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  etablissementId String? @map("etablissement_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid // null = action système
  action      String // ex: SALE_CREATE, SALE_CANCEL, USER_CREATE, PIN_LOGIN
  entity      String? // ex: sale, product, user
  entityId    String?  @map("entity_id")
  metadata    Json?
  ip          String?
  deviceLabel String?  @map("device_label")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  etablissement Etablissement? @relation(fields: [etablissementId], references: [id])

  @@index([tenantId, createdAt])
  @@map("activity_logs")
}

// ─────────────────────── Reçu public (QR → page Wilinwi) ───────────────────────
// Données DÉNORMALISÉES & non sensibles, lisibles publiquement par code opaque.
// PAS de RLS (lecture publique volontaire) ; ne contient jamais coût/marge/client.

model PublicReceipt {
  code         String    @id // code court opaque (= Sale.receiptCode)
  tenantId     String    @map("tenant_id") @db.Uuid
  boutiqueNom  String    @map("boutique_nom")
  total        Int
  montantVerse Int       @map("montant_verse")
  items        Json // [{ nom, quantite, prixReel }]
  saleDate     DateTime  @map("sale_date")
  // Posé à l'annulation de la vente : le reçu reste consultable mais affiche
  // clairement « VENTE ANNULÉE » (il ne vaut plus preuve d'achat).
  cancelledAt  DateTime? @map("cancelled_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("public_receipts")
}

model User {
  id        String   @id @db.Uuid // = id Supabase Auth (auth.users)
  tenantId  String   @map("tenant_id") @db.Uuid
  nom       String
  email     String
  role      Role     @default(SELLER)
  actif     Boolean  @default(true)
  poste     String? // intitulé de poste libre (ex: Caissier principal)
  /// Hash du code PIN (bcrypt) pour le login sur poste partagé. Jamais en clair.
  pinCode   String?  @map("pin_code")
  /// true → utilise `permissions` (overrides) ; false → modules par défaut du rôle.
  customPermissions Boolean  @default(false) @map("custom_permissions")
  /// Modules autorisés (clés ModuleKey) quand customPermissions = true.
  permissions       String[] @default([])
  createdAt DateTime @default(now()) @map("created_at")

  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ventesEffectuees  Sale[]          @relation("VendeurVentes")
  livraisons        Sale[]          @relation("LivreurLivraisons")
  inventoriesValid  Inventory[]     @relation("InventoryValidator")
  etablissements    UserEtablissement[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

// ───────────────────────────── Stock ─────────────────────────────────

model Product {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  nom           String
  sku           String?
  categorie     String?
  type          ProductType @default(STANDARD)
  stockPolicy   StockPolicy @default(STRICT) @map("stock_policy")
  unitKind      UnitKind    @default(UNIT) @map("unit_kind")
  baseUnit      String?     @map("base_unit")
  photos        String[]    @default([])
  prixAchat     Int         @map("prix_achat") // sensible
  prixPlancher  Int         @map("prix_plancher") // sensible
  prixCatalogue Int         @map("prix_catalogue")
  stock         Int         @default(0)
  seuilAlerte   Int         @default(5) @map("seuil_alerte")
  actif         Boolean     @default(true)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variants  ProductVariant[]
  movements StockMovement[]
  saleItems SaleItem[]
  purchaseItems PurchaseOrderItem[]
  stocks    ProductStock[]
  dispatchItems DispatchOrderItem[]
  recipe        ProductRecipe?
  recipeUsages  RecipeItem[]        @relation("RecipeIngredient")

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([tenantId, type])
  @@map("products")
}

// ─────────────────── Food (Milestone 3) — recettes & tables ───────────────────

// Recette d'un produit MANUFACTURED : à la vente du plat, les ingrédients sont
// décrémentés (si `active`). Le plat lui-même n'a pas de stock direct (§9.1).
model ProductRecipe {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  productId String   @unique @map("product_id") @db.Uuid
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  items   RecipeItem[]

  @@index([tenantId])
  @@map("product_recipes")
}

model RecipeItem {
  id                  String @id @default(uuid()) @db.Uuid
  tenantId            String @map("tenant_id") @db.Uuid
  recipeId            String @map("recipe_id") @db.Uuid
  ingredientProductId String @map("ingredient_product_id") @db.Uuid
  /// Quantité consommée PAR PLAT VENDU, dans l'échelle de l'ingrédient (§19.1 :
  /// milli-unités pour WEIGHT/VOLUME — 200 g de riz = 200 si baseUnit "g",
  /// ou 0,2 kg = 200 milli-kg). Pas d'unité libre : celle de l'ingrédient fait foi.
  quantite            Int

  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipe     ProductRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Product       @relation("RecipeIngredient", fields: [ingredientProductId], references: [id], onDelete: Cascade)

  @@unique([recipeId, ingredientProductId])
  @@index([tenantId])
  @@index([recipeId])
  @@map("recipe_items")
}

// Table d'un établissement FOOD (minimaliste : un nom, un panier de vente s'y rattache).
model FoodTable {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  etablissementId String   @map("etablissement_id") @db.Uuid
  nom             String
  actif           Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  etablissement Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  sales         Sale[]

  @@unique([etablissementId, nom])
  @@index([tenantId])
  @@index([tenantId, etablissementId])
  @@map("food_tables")
}

model ProductVariant {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  attributs Json // { taille: 'L', couleur: 'rouge' }
  sku       String?
  stock     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([productId])
  @@map("product_variants")
}

model StockMovement {
  id        String            @id @default(uuid()) @db.Uuid
  tenantId  String            @map("tenant_id") @db.Uuid
  etablissementId String?     @map("etablissement_id") @db.Uuid
  productId String            @map("product_id") @db.Uuid
  variantId String?           @map("variant_id") @db.Uuid
  type      StockMovementType
  quantite  Int // signé selon le type
  motif     String
  saleId    String?           @map("sale_id") @db.Uuid
  createdAt DateTime          @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  etablissement Etablissement? @relation(fields: [etablissementId], references: [id])
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([productId])
  @@map("stock_movements")
}

// ───────────────────────── Inventaire physique ───────────────────────

model Inventory {
  id          String          @id @default(uuid()) @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  etablissementId String?     @map("etablissement_id") @db.Uuid
  libelle     String?
  status      InventoryStatus @default(OPEN)
  motif       String?
  validatedBy String?         @map("validated_by") @db.Uuid
  validatedAt DateTime?       @map("validated_at")
  createdAt   DateTime        @default(now()) @map("created_at")

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  etablissement Etablissement? @relation(fields: [etablissementId], references: [id])
  validator User?           @relation("InventoryValidator", fields: [validatedBy], references: [id])
  items     InventoryItem[]

  @@index([tenantId])
  @@map("inventories")
}

model InventoryItem {
  id               String  @id @default(uuid()) @db.Uuid
  tenantId         String  @map("tenant_id") @db.Uuid
  inventoryId      String  @map("inventory_id") @db.Uuid
  productId        String  @map("product_id") @db.Uuid
  variantId        String? @map("variant_id") @db.Uuid
  quantiteTheorique Int    @map("quantite_theorique")
  quantiteReelle   Int?    @map("quantite_reelle")
  ecart            Int? // reelle - theorique, calculé à la saisie

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([inventoryId])
  @@map("inventory_items")
}

// ───────────────────────────── Ventes ────────────────────────────────

model Sale {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  etablissementId  String?       @map("etablissement_id") @db.Uuid
  vendeurId        String        @map("vendeur_id") @db.Uuid
  clientId         String?       @map("client_id") @db.Uuid // CRM en MVP2
  status           SaleStatus    @default(COMPLETED)
  paymentMethod    PaymentMethod @map("payment_method")
  total            Int // somme des lignes (prix réel)
  montantVerse     Int           @default(0) @map("montant_verse")
  /// Part payée en ESPÈCES dans un paiement mixte (le reste via paymentMethod).
  montantEspeces   Int           @default(0) @map("montant_especes")
  /// Identifiant généré côté client pour l'idempotence de la sync offline.
  clientGeneratedId String?      @map("client_generated_id")
  /// Code court opaque du reçu public (QR → page wilinwi.com/r/<code>).
  receiptCode      String?       @unique @map("receipt_code")
  /// Table (établissement FOOD) à laquelle la vente est rattachée — Milestone 3.
  tableId          String?       @map("table_id") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at")

  // ── Livraison (MVP minimal) : une vente peut être marquée « à livrer », assignée
  //    à un livreur, puis marquée livrée. Statut dérivé : aLivrer && !livreLe = à livrer.
  //    Le destinataire (nom + téléphone) est porté par le Client lié (clientId).
  aLivrer          Boolean       @default(false) @map("a_livrer")
  livreurId        String?       @map("livreur_id") @db.Uuid
  adresseLivraison String?       @map("adresse_livraison")
  livreLe          DateTime?     @map("livre_le")

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  etablissement Etablissement? @relation(fields: [etablissementId], references: [id])
  vendeur     User             @relation("VendeurVentes", fields: [vendeurId], references: [id])
  livreur     User?            @relation("LivreurLivraisons", fields: [livreurId], references: [id])
  client      Client?          @relation(fields: [clientId], references: [id])
  table       FoodTable?       @relation(fields: [tableId], references: [id])
  items       SaleItem[]
  installment SaleInstallment?

  @@unique([tenantId, clientGeneratedId])
  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, livreurId])
  @@index([tenantId, etablissementId])
  @@map("sales")
}

model SaleItem {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  saleId    String  @map("sale_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  variantId String? @map("variant_id") @db.Uuid
  quantite  Int
  quantiteRetournee Int @default(0) @map("quantite_retournee")
  prixReel  Int     @map("prix_reel") // 4ᵉ prix : réellement négocié
  /// Coût figé au moment de la vente (prix d'achat), pour le calcul de marge.
  coutUnitaire Int  @map("cout_unitaire")

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([tenantId])
  @@index([saleId])
  @@map("sale_items")
}

model SaleInstallment {
  id            String            @id @default(uuid()) @db.Uuid
  tenantId      String            @map("tenant_id") @db.Uuid
  saleId        String            @unique @map("sale_id") @db.Uuid
  montantTotal  Int               @map("montant_total")
  montantVerse  Int               @map("montant_verse")
  soldeRestant  Int               @map("solde_restant")
  status        InstallmentStatus @default(PARTIAL)
  echeance      DateTime?
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("sale_installments")
}

// ──────────────── Traçabilité des prix négociés (§5.5) ────────────────

// ─────────────────────── CRM — Clients & Dettes (MVP2) ───────────────────────

model Client {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  nom           String
  telephone     String?
  /// Dette courante du client (sensible — masquée aux rôles non autorisés).
  soldeCredit   Int      @default(0) @map("solde_credit")
  /// Plafond de crédit autorisé. null = illimité (sensible).
  plafondCredit Int?     @map("plafond_credit")
  notes         String?
  actif         Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sales    Sale[]
  payments ClientPayment[]

  @@index([tenantId])
  @@map("clients")
}

model ClientPayment {
  id        String        @id @default(uuid()) @db.Uuid
  tenantId  String        @map("tenant_id") @db.Uuid
  clientId  String        @map("client_id") @db.Uuid
  montant   Int
  methode   PaymentMethod @default(CASH)
  note      String?
  saleId    String?       @map("sale_id") @db.Uuid // remboursement rattaché à une vente (optionnel)
  createdBy String        @map("created_by") @db.Uuid
  createdAt DateTime      @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([clientId])
  @@map("client_payments")
}

// ─────────────────────── Trésorerie — Wilinwi Pay (MVP2) ───────────────────────

enum CashAccount {
  CAISSE // espèces
  MOBILE_MONEY // Mobile Money (MoMo, Moov, Celtiis, Orange… regroupés)
  BANQUE // virement / banque
}

enum CashFlowType {
  IN
  OUT
}

enum CashMovementSource {
  SALE // encaissement d'une vente
  EXPENSE // dépense (loyer, salaire, réappro…)
  REPAYMENT // remboursement de dette client / acompte
  TRANSFER // virement entre comptes
  ADJUSTMENT // ajustement (écart de clôture)
  OPENING // solde d'ouverture
}

model CashMovement {
  id        String             @id @default(uuid()) @db.Uuid
  tenantId  String             @map("tenant_id") @db.Uuid
  etablissementId String?      @map("etablissement_id") @db.Uuid
  type      CashFlowType
  compte    CashAccount
  montant   Int // toujours positif ; le sens est porté par `type`
  source    CashMovementSource
  categorie String? // pour EXPENSE : loyer/électricité/salaire/réappro/autre
  note      String?
  saleId    String?            @map("sale_id") @db.Uuid
  createdBy String             @map("created_by") @db.Uuid
  createdAt DateTime           @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  etablissement Etablissement? @relation(fields: [etablissementId], references: [id])

  @@index([tenantId])
  @@index([tenantId, compte])
  @@index([tenantId, createdAt])
  @@index([tenantId, etablissementId])
  @@map("cash_movements")
}

model CashClose {
  id             String      @id @default(uuid()) @db.Uuid
  tenantId       String      @map("tenant_id") @db.Uuid
  etablissementId String?    @map("etablissement_id") @db.Uuid
  compte         CashAccount @default(CAISSE)
  soldeTheorique Int         @map("solde_theorique")
  soldeReel      Int         @map("solde_reel")
  ecart          Int // soldeReel - soldeTheorique
  note           String?
  closedBy       String      @map("closed_by") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  etablissement Etablissement? @relation(fields: [etablissementId], references: [id])

  @@index([tenantId])
  @@map("cash_closes")
}

// ─────────────────── Entrepôt — Fournisseurs & Achats (MVP2) ───────────────────
// Gestion de l'approvisionnement : fournisseurs (avec dette), bons de commande
// et réception (ravitaillement → mouvements de stock IN), paiements fournisseurs.

enum PurchaseOrderStatus {
  DRAFT // brouillon
  ORDERED // commandé (envoyé au fournisseur)
  PARTIAL // partiellement reçu
  RECEIVED // entièrement reçu
  CANCELLED
}

model Supplier {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  nom         String
  telephone   String?
  contact     String? // personne de contact
  adresse     String?
  notes       String?
  /// Dette courante envers le fournisseur (ce qu'on lui doit). Sensible.
  soldeDette  Int      @default(0) @map("solde_dette")
  actif       Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]
  payments       SupplierPayment[]

  @@index([tenantId])
  @@map("suppliers")
}

model PurchaseOrder {
  id              String              @id @default(uuid()) @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  etablissementId String              @map("etablissement_id") @db.Uuid // lieu de réception
  fournisseurId   String              @map("fournisseur_id") @db.Uuid
  reference       String // code lisible (ex: BC-AB12CD)
  statut          PurchaseOrderStatus @default(DRAFT)
  montantTotal    Int                 @map("montant_total") // Σ lignes commandées
  montantRecu     Int                 @default(0) @map("montant_recu") // valeur réceptionnée
  montantPaye     Int                 @default(0) @map("montant_paye")
  notes           String?
  createdBy       String              @map("created_by") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  etablissement Etablissement       @relation(fields: [etablissementId], references: [id])
  fournisseur   Supplier            @relation(fields: [fournisseurId], references: [id])
  items         PurchaseOrderItem[]

  @@index([tenantId])
  @@index([tenantId, statut])
  @@index([tenantId, fournisseurId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String  @id @default(uuid()) @db.Uuid
  tenantId         String  @map("tenant_id") @db.Uuid
  purchaseOrderId  String  @map("purchase_order_id") @db.Uuid
  productId        String  @map("product_id") @db.Uuid
  variantId        String? @map("variant_id") @db.Uuid
  quantiteCommandee Int    @map("quantite_commandee")
  quantiteRecue    Int     @default(0) @map("quantite_recue")
  prixUnitaire     Int     @map("prix_unitaire") // coût d'achat unitaire

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])

  @@index([tenantId])
  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

model SupplierPayment {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  fournisseurId   String        @map("fournisseur_id") @db.Uuid
  etablissementId String?       @map("etablissement_id") @db.Uuid
  montant         Int
  methode         PaymentMethod @default(CASH)
  note            String?
  purchaseOrderId String?       @map("purchase_order_id") @db.Uuid
  createdBy       String        @map("created_by") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at")

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fournisseur Supplier @relation(fields: [fournisseurId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([fournisseurId])
  @@map("supplier_payments")
}

// ─────────────────── Stock par emplacement (Phase A — projection) ───────────────────
// Solde matérialisé du stock par (produit/variante × établissement). C'est la
// PROJECTION du grand livre `StockMovement` (= Σ mouvements), pour des lectures
// O(1) et un seuil de réappro `quantiteMin` propre à chaque emplacement.
// Double-écriture avec `Product.stock` pendant la transition (cf. doc §7).
// Unicité (etab, produit, variante) renforcée par index partiels (rls.sql).

model ProductStock {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  variantId       String?  @map("variant_id") @db.Uuid
  etablissementId String   @map("etablissement_id") @db.Uuid
  quantite        Int      @default(0)
  quantiteMin     Int      @default(0) @map("quantite_min") // alerte si quantite <= quantiteMin
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  etablissement Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([etablissementId])
  @@index([productId])
  @@map("product_stock")
}

// ─────────────────── Dispatch / Transfert interne (Phase B) ───────────────────
// Déplacement formel de marchandise entrepôt → boutique : brouillon → validation.
// La validation déplace le stock des DEUX emplacements (ProductStock + mouvements).

enum DispatchStatus {
  DRAFT // créé, pas encore validé
  VALIDATED // validé — le stock a bougé
  CANCELLED // annulé avant validation
}

model DispatchOrder {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  sourceId      String         @map("source_id") @db.Uuid // établissement source (entrepôt)
  destinationId String         @map("destination_id") @db.Uuid // établissement destination (boutique)
  reference     String
  statut        DispatchStatus @default(DRAFT)
  note          String?
  createdBy     String         @map("created_by") @db.Uuid
  validatedBy   String?        @map("validated_by") @db.Uuid
  validatedAt   DateTime?      @map("validated_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source      Etablissement       @relation("DispatchSource", fields: [sourceId], references: [id])
  destination Etablissement       @relation("DispatchDestination", fields: [destinationId], references: [id])
  items       DispatchOrderItem[]

  @@index([tenantId])
  @@index([tenantId, statut])
  @@map("dispatch_orders")
}

model DispatchOrderItem {
  id              String  @id @default(uuid()) @db.Uuid
  tenantId        String  @map("tenant_id") @db.Uuid
  dispatchOrderId String  @map("dispatch_order_id") @db.Uuid
  productId       String  @map("product_id") @db.Uuid
  variantId       String? @map("variant_id") @db.Uuid
  quantite        Int

  dispatchOrder DispatchOrder @relation(fields: [dispatchOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])

  @@index([tenantId])
  @@index([dispatchOrderId])
  @@map("dispatch_order_items")
}

// ─────────────────── Notifications in-app (centre de pilotage) ───────────────────
// Alertes poussées au propriétaire/gérant (stock bas, impayé…). État de lecture au
// niveau entreprise (lu = traité par un admin). Dérivées des alertes déjà calculées.

enum NotificationType {
  STOCK_LOW // produit sous son seuil de réappro
  PAST_DUE // abonnement impayé
  SUPPLIER_DEBT // dette fournisseur
  INFO
}

model Notification {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  etablissementId String?          @map("etablissement_id") @db.Uuid
  type            NotificationType
  titre           String
  message         String
  /// Référence de l'entité concernée (ex: productId) — sert à la déduplication.
  entityId        String?          @map("entity_id")
  readAt          DateTime?        @map("read_at")
  createdAt       DateTime         @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, readAt])
  @@index([tenantId, type])
  @@map("notifications")
}

// Alerte d'audit (TDR §18.2) : anomalie détectée A POSTERIORI qui n'a pas bloqué
// l'opération (ex. stock passé en négatif via ALLOW_NEGATIVE, conflit de lot
// offline Health à venir). Visible côté tenant (OWNER/MANAGER) ET remontée à la
// console super-admin pour les gravités élevées. Jamais supprimée : résolue.
model AuditAlert {
  id              String             @id @default(uuid()) @db.Uuid
  tenantId        String             @map("tenant_id") @db.Uuid
  etablissementId String?            @map("etablissement_id") @db.Uuid
  severity        AuditAlertSeverity @default(WARNING)
  /// Slug stable du type d'anomalie (ex: 'stock.negative', 'health.batch_conflict').
  type            String
  message         String
  /// Contexte structuré (produit, quantités, vente…) pour la correction manuelle.
  payload         Json?
  resolvedAt      DateTime?          @map("resolved_at")
  resolvedBy      String?            @map("resolved_by") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, resolvedAt])
  @@index([tenantId, severity])
  @@map("audit_alerts")
}

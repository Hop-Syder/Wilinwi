// // ──────────────────────────────────

// Wilinwi — schéma de données MVP1 « Le Socle »
// Monolithe modulaire, multi-tenant. Toutes les tables (sauf Tenant) portent
// un tenantId et sont protégées par RLS (cf. prisma/migrations/.../rls.sql).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────── Enums ───────────────────────────────

enum Role {
  OWNER
  MANAGER
  SELLER
  CASHIER
  DELIVERY
}

enum Plan {
  STARTER
  PRO
  BUSINESS
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELLED
}

// Type d'établissement (lieu physique d'exploitation d'une entreprise).
enum EtablissementType {
  BOUTIQUE
  SUPERMARCHE
  PHARMACIE
  RESTAURANT
  ENTREPOT
  AGENCE
  BUREAU
  USINE
}

enum StockMovementType {
  IN
  OUT
  ADJUST
}

enum InventoryStatus {
  OPEN
  VALIDATED
  CANCELLED
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY // générique : MoMo, Moov, Celtiis, Orange… (regroupés)
  BANK_TRANSFER
  CREDIT
  INSTALLMENT
}

enum SaleStatus {
  COMPLETED
  PENDING_PAYMENT  // acompte / crédit en cours
  PENDING_APPROVAL // vente sous le plancher en attente de validation gérant
  CANCELLED
}

enum InstallmentStatus {
  PENDING
  PARTIAL
  SETTLED
  OVERDUE
}

enum PriceOverrideStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─────────────────────────────── ADN ─────────────────────────────────

model Tenant {
  id                 String             @id @default(uuid()) @db.Uuid
  nom                String
  plan               Plan               @default(STARTER)
  subscriptionStatus SubscriptionStatus @default(TRIALING) @map("subscription_status")
  /// Date de passage en impayé (PAST_DUE) → pilote la relance progressive (J+0/J+3/J+7/J+30).
  pastDueSince       DateTime?          @map("past_due_since")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  users           User[]
  products        Product[]
  stockMovements  StockMovement[]
  inventories     Inventory[]
  sales           Sale[]
  saleInstallments SaleInstallment[]
  priceOverrides  PriceOverride[]
  clients         Client[]
  clientPayments  ClientPayment[]
  cashMovements   CashMovement[]
  cashCloses      CashClose[]
  activityLogs    ActivityLog[]
  etablissements      Etablissement[]
  userEtablissements  UserEtablissement[]
  suppliers       Supplier[]
  purchaseOrders  PurchaseOrder[]
  supplierPayments SupplierPayment[]
  productStocks   ProductStock[]
  dispatchOrders  DispatchOrder[]
  notifications   Notification[]

  @@map("tenants")
}

// ─────────────────── Établissements (lieux physiques) ───────────────────
// Une Entreprise (= Tenant) possède plusieurs établissements. Les données
// transactionnelles (ventes, mouvements de stock, trésorerie, inventaires)
// sont rattachées à un établissement. Le catalogue produits et les clients
// restent au niveau Entreprise (Phase 1).

model Etablissement {
  id        String            @id @default(uuid()) @db.Uuid
  tenantId  String            @map("tenant_id") @db.Uuid
  nom       String
  type      EtablissementType @default(BOUTIQUE)
  ville     String?
  adresse   String?
  telephone String?
  actif     Boolean           @default(true)
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userAccess     UserEtablissement[]
  sales          Sale[]
  stockMovements StockMovement[]
  cashMovements  CashMovement[]
  cashCloses     CashClose[]
  inventories    Inventory[]
  activityLogs   ActivityLog[]
  purchaseOrders PurchaseOrder[]
  productStocks  ProductStock[]
  dispatchSources      DispatchOrder[] @relation("DispatchSource")
  dispatchDestinations DispatchOrder[] @relation("DispatchDestination")

  @@index([tenantId])
  @@map("etablissements")
}

// Accès d'un employé à un établissement (un employé peut accéder à 0..N).
model UserEtablissement {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  etablissementId String   @map("etablissement_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  etablissement Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)

  @@unique([userId, etablissementId])
  @@index([tenantId])
  @@index([etablissementId])
  @@map("user_etablissements")
}

// ─────────────────────── Journal d'activité — Audit (MVP2) ───────────────────────

model ActivityLog {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  etablissementId String? @map("etablissement_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid // null = action système
  action      String // ex: SALE_CREATE, SALE_CANCEL, USER_CREATE, PIN_LOGIN
  entity      String? // ex: sale, product, user
  entityId    String?  @map("entity_id")
  metadata    Json?
  ip          String?
  deviceLabel String?  @map("device_label")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  etablissement Etablissement? @relation(fields: [etablissementId], references: [id])

  @@index([tenantId, createdAt])
  @@map("activity_logs")
}

// ─────────────────────── Reçu public (QR → page Wilinwi) ───────────────────────
// Données DÉNORMALISÉES & non sensibles, lisibles publiquement par code opaque.
// PAS de RLS (lecture publique volontaire) ; ne contient jamais coût/marge/client.

model PublicReceipt {
  code         String   @id // code court opaque (= Sale.receiptCode)
  tenantId     String   @map("tenant_id") @db.Uuid
  boutiqueNom  String   @map("boutique_nom")
  total        Int
  montantVerse Int      @map("montant_verse")
  items        Json // [{ nom, quantite, prixReel }]
  saleDate     DateTime @map("sale_date")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("public_receipts")
}

model User {
  id        String   @id @db.Uuid // = id Supabase Auth (auth.users)
  tenantId  String   @map("tenant_id") @db.Uuid
  nom       String
  email     String
  role      Role     @default(SELLER)
  actif     Boolean  @default(true)
  poste     String? // intitulé de poste libre (ex: Caissier principal)
  /// Hash du code PIN (bcrypt) pour le login sur poste partagé. Jamais en clair.
  pinCode   String?  @map("pin_code")
  /// true → utilise `permissions` (overrides) ; false → modules par défaut du rôle.
  customPermissions Boolean  @default(false) @map("custom_permissions")
  /// Modules autorisés (clés ModuleKey) quand customPermissions = true.
  permissions       String[] @default([])
  createdAt DateTime @default(now()) @map("created_at")

  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ventesEffectuees  Sale[]          @relation("VendeurVentes")
  livraisons        Sale[]          @relation("LivreurLivraisons")
  inventoriesValid  Inventory[]     @relation("InventoryValidator")
  overridesDemandes PriceOverride[] @relation("OverrideRequester")
  overridesValides  PriceOverride[] @relation("OverrideApprover")
  etablissements    UserEtablissement[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

// ───────────────────────────── Stock ─────────────────────────────────

model Product {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  nom           String
  sku           String?
  categorie     String?
  photos        String[] @default([])
  prixAchat     Int      @map("prix_achat") // sensible
  prixPlancher  Int      @map("prix_plancher") // sensible
  prixCatalogue Int      @map("prix_catalogue")
  stock         Int      @default(0)
  seuilAlerte   Int      @default(5) @map("seuil_alerte")
  actif         Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variants  ProductVariant[]
  movements StockMovement[]
  saleItems SaleItem[]
  purchaseItems PurchaseOrderItem[]
  stocks    ProductStock[]
  dispatchItems DispatchOrderItem[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@map("products")
}

model ProductVariant {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  attributs Json // { taille: 'L', couleur: 'rouge' }
  sku       String?
  stock     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([productId])
  @@map("product_variants")
}

model StockMovement {
  id        String            @id @default(uuid()) @db.Uuid
  tenantId  String            @map("tenant_id") @db.Uuid
  etablissementId String?     @map("etablissement_id") @db.Uuid
  productId String            @map("product_id") @db.Uuid
  variantId String?           @map("variant_id") @db.Uuid
  type      StockMovementType
  quantite  Int // signé selon le type
  motif     String
  saleId    String?           @map("sale_id") @db.Uuid
  createdAt DateTime          @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  etablissement Etablissement? @relation(fields: [etablissementId], references: [id])
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([productId])
  @@map("stock_movements")
}

// ───────────────────────── Inventaire physique ───────────────────────

model Inventory {
  id          String          @id @default(uuid()) @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  etablissementId String?     @map("etablissement_id") @db.Uuid
  libelle     String?
  status      InventoryStatus @default(OPEN)
  motif       String?
  validatedBy String?         @map("validated_by") @db.Uuid
  validatedAt DateTime?       @map("validated_at")
  createdAt   DateTime        @default(now()) @map("created_at")

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  etablissement Etablissement? @relation(fields: [etablissementId], references: [id])
  validator User?           @relation("InventoryValidator", fields: [validatedBy], references: [id])
  items     InventoryItem[]

  @@index([tenantId])
  @@map("inventories")
}

model InventoryItem {
  id               String  @id @default(uuid()) @db.Uuid
  tenantId         String  @map("tenant_id") @db.Uuid
  inventoryId      String  @map("inventory_id") @db.Uuid
  productId        String  @map("product_id") @db.Uuid
  variantId        String? @map("variant_id") @db.Uuid
  quantiteTheorique Int    @map("quantite_theorique")
  quantiteReelle   Int?    @map("quantite_reelle")
  ecart            Int? // reelle - theorique, calculé à la saisie

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([inventoryId])
  @@map("inventory_items")
}

// ───────────────────────────── Ventes ────────────────────────────────

model Sale {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  etablissementId  String?       @map("etablissement_id") @db.Uuid
  vendeurId        String        @map("vendeur_id") @db.Uuid
  clientId         String?       @map("client_id") @db.Uuid // CRM en MVP2
  status           SaleStatus    @default(COMPLETED)
  paymentMethod    PaymentMethod @map("payment_method")
  total            Int // somme des lignes (prix réel)
  montantVerse     Int           @default(0) @map("montant_verse")
  /// Part payée en ESPÈCES dans un paiement mixte (le reste via paymentMethod).
  montantEspeces   Int           @default(0) @map("montant_especes")
  /// Identifiant généré côté client pour l'idempotence de la sync offline.
  clientGeneratedId String?      @map("client_generated_id")
  /// Code court opaque du reçu public (QR → page wilinwi.com/r/<code>).
  receiptCode      String?       @unique @map("receipt_code")
  createdAt        DateTime      @default(now()) @map("created_at")

  // ── Livraison (MVP minimal) : une vente peut être marquée « à livrer », assignée
  //    à un livreur, puis marquée livrée. Statut dérivé : aLivrer && !livreLe = à livrer.
  //    Le destinataire (nom + téléphone) est porté par le Client lié (clientId).
  aLivrer          Boolean       @default(false) @map("a_livrer")
  livreurId        String?       @map("livreur_id") @db.Uuid
  adresseLivraison String?       @map("adresse_livraison")
  livreLe          DateTime?     @map("livre_le")

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  etablissement Etablissement? @relation(fields: [etablissementId], references: [id])
  vendeur     User             @relation("VendeurVentes", fields: [vendeurId], references: [id])
  livreur     User?            @relation("LivreurLivraisons", fields: [livreurId], references: [id])
  client      Client?          @relation(fields: [clientId], references: [id])
  items       SaleItem[]
  installment SaleInstallment?

  @@unique([tenantId, clientGeneratedId])
  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, livreurId])
  @@index([tenantId, etablissementId])
  @@map("sales")
}

model SaleItem {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  saleId    String  @map("sale_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  variantId String? @map("variant_id") @db.Uuid
  quantite  Int
  quantiteRetournee Int @default(0) @map("quantite_retournee")
  prixReel  Int     @map("prix_reel") // 4ᵉ prix : réellement négocié
  /// Coût figé au moment de la vente (prix d'achat), pour le calcul de marge.
  coutUnitaire Int  @map("cout_unitaire")

  sale          Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product       Product        @relation(fields: [productId], references: [id])
  priceOverride PriceOverride?

  @@index([tenantId])
  @@index([saleId])
  @@map("sale_items")
}

model SaleInstallment {
  id            String            @id @default(uuid()) @db.Uuid
  tenantId      String            @map("tenant_id") @db.Uuid
  saleId        String            @unique @map("sale_id") @db.Uuid
  montantTotal  Int               @map("montant_total")
  montantVerse  Int               @map("montant_verse")
  soldeRestant  Int               @map("solde_restant")
  status        InstallmentStatus @default(PARTIAL)
  echeance      DateTime?
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("sale_installments")
}

// ──────────────── Traçabilité des prix négociés (§5.5) ────────────────

model PriceOverride {
  id                String              @id @default(uuid()) @db.Uuid
  tenantId          String              @map("tenant_id") @db.Uuid
  saleItemId        String              @unique @map("sale_item_id") @db.Uuid
  prixPlancher      Int                 @map("prix_plancher") // figé au moment de la vente
  prixApplique      Int                 @map("prix_applique")
  motif             String // preuve obligatoire
  status            PriceOverrideStatus @default(PENDING)
  requestedBy       String              @map("requested_by") @db.Uuid
  approvedBy        String?             @map("approved_by") @db.Uuid
  approvedAt        DateTime?           @map("approved_at")
  createdAt         DateTime            @default(now()) @map("created_at")

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  saleItem  SaleItem @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  requester User     @relation("OverrideRequester", fields: [requestedBy], references: [id])
  approver  User?    @relation("OverrideApprover", fields: [approvedBy], references: [id])

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("price_overrides")
}

// ─────────────────────── CRM — Clients & Dettes (MVP2) ───────────────────────

model Client {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  nom           String
  telephone     String?
  /// Dette courante du client (sensible — masquée aux rôles non autorisés).
  soldeCredit   Int      @default(0) @map("solde_credit")
  /// Plafond de crédit autorisé. null = illimité (sensible).
  plafondCredit Int?     @map("plafond_credit")
  notes         String?
  actif         Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sales    Sale[]
  payments ClientPayment[]

  @@index([tenantId])
  @@map("clients")
}

model ClientPayment {
  id        String        @id @default(uuid()) @db.Uuid
  tenantId  String        @map("tenant_id") @db.Uuid
  clientId  String        @map("client_id") @db.Uuid
  montant   Int
  methode   PaymentMethod @default(CASH)
  note      String?
  saleId    String?       @map("sale_id") @db.Uuid // remboursement rattaché à une vente (optionnel)
  createdBy String        @map("created_by") @db.Uuid
  createdAt DateTime      @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([clientId])
  @@map("client_payments")
}

// ─────────────────────── Trésorerie — Wilinwi Pay (MVP2) ───────────────────────

enum CashAccount {
  CAISSE // espèces
  MOBILE_MONEY // Mobile Money (MoMo, Moov, Celtiis, Orange… regroupés)
  BANQUE // virement / banque
}

enum CashFlowType {
  IN
  OUT
}

enum CashMovementSource {
  SALE // encaissement d'une vente
  EXPENSE // dépense (loyer, salaire, réappro…)
  REPAYMENT // remboursement de dette client / acompte
  TRANSFER // virement entre comptes
  ADJUSTMENT // ajustement (écart de clôture)
  OPENING // solde d'ouverture
}

model CashMovement {
  id        String             @id @default(uuid()) @db.Uuid
  tenantId  String             @map("tenant_id") @db.Uuid
  etablissementId String?      @map("etablissement_id") @db.Uuid
  type      CashFlowType
  compte    CashAccount
  montant   Int // toujours positif ; le sens est porté par `type`
  source    CashMovementSource
  categorie String? // pour EXPENSE : loyer/électricité/salaire/réappro/autre
  note      String?
  saleId    String?            @map("sale_id") @db.Uuid
  createdBy String             @map("created_by") @db.Uuid
  createdAt DateTime           @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  etablissement Etablissement? @relation(fields: [etablissementId], references: [id])

  @@index([tenantId])
  @@index([tenantId, compte])
  @@index([tenantId, createdAt])
  @@index([tenantId, etablissementId])
  @@map("cash_movements")
}

model CashClose {
  id             String      @id @default(uuid()) @db.Uuid
  tenantId       String      @map("tenant_id") @db.Uuid
  etablissementId String?    @map("etablissement_id") @db.Uuid
  compte         CashAccount @default(CAISSE)
  soldeTheorique Int         @map("solde_theorique")
  soldeReel      Int         @map("solde_reel")
  ecart          Int // soldeReel - soldeTheorique
  note           String?
  closedBy       String      @map("closed_by") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  etablissement Etablissement? @relation(fields: [etablissementId], references: [id])

  @@index([tenantId])
  @@map("cash_closes")
}

// ─────────────────── Entrepôt — Fournisseurs & Achats (MVP2) ───────────────────
// Gestion de l'approvisionnement : fournisseurs (avec dette), bons de commande
// et réception (ravitaillement → mouvements de stock IN), paiements fournisseurs.

enum PurchaseOrderStatus {
  DRAFT // brouillon
  ORDERED // commandé (envoyé au fournisseur)
  PARTIAL // partiellement reçu
  RECEIVED // entièrement reçu
  CANCELLED
}

model Supplier {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  nom         String
  telephone   String?
  contact     String? // personne de contact
  adresse     String?
  notes       String?
  /// Dette courante envers le fournisseur (ce qu'on lui doit). Sensible.
  soldeDette  Int      @default(0) @map("solde_dette")
  actif       Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]
  payments       SupplierPayment[]

  @@index([tenantId])
  @@map("suppliers")
}

model PurchaseOrder {
  id              String              @id @default(uuid()) @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  etablissementId String              @map("etablissement_id") @db.Uuid // lieu de réception
  fournisseurId   String              @map("fournisseur_id") @db.Uuid
  reference       String // code lisible (ex: BC-AB12CD)
  statut          PurchaseOrderStatus @default(DRAFT)
  montantTotal    Int                 @map("montant_total") // Σ lignes commandées
  montantRecu     Int                 @default(0) @map("montant_recu") // valeur réceptionnée
  montantPaye     Int                 @default(0) @map("montant_paye")
  notes           String?
  createdBy       String              @map("created_by") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  etablissement Etablissement       @relation(fields: [etablissementId], references: [id])
  fournisseur   Supplier            @relation(fields: [fournisseurId], references: [id])
  items         PurchaseOrderItem[]

  @@index([tenantId])
  @@index([tenantId, statut])
  @@index([tenantId, fournisseurId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String  @id @default(uuid()) @db.Uuid
  tenantId         String  @map("tenant_id") @db.Uuid
  purchaseOrderId  String  @map("purchase_order_id") @db.Uuid
  productId        String  @map("product_id") @db.Uuid
  variantId        String? @map("variant_id") @db.Uuid
  quantiteCommandee Int    @map("quantite_commandee")
  quantiteRecue    Int     @default(0) @map("quantite_recue")
  prixUnitaire     Int     @map("prix_unitaire") // coût d'achat unitaire

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])

  @@index([tenantId])
  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

model SupplierPayment {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  fournisseurId   String        @map("fournisseur_id") @db.Uuid
  etablissementId String?       @map("etablissement_id") @db.Uuid
  montant         Int
  methode         PaymentMethod @default(CASH)
  note            String?
  purchaseOrderId String?       @map("purchase_order_id") @db.Uuid
  createdBy       String        @map("created_by") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at")

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fournisseur Supplier @relation(fields: [fournisseurId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([fournisseurId])
  @@map("supplier_payments")
}

// ─────────────────── Stock par emplacement (Phase A — projection) ───────────────────
// Solde matérialisé du stock par (produit/variante × établissement). C'est la
// PROJECTION du grand livre `StockMovement` (= Σ mouvements), pour des lectures
// O(1) et un seuil de réappro `quantiteMin` propre à chaque emplacement.
// Double-écriture avec `Product.stock` pendant la transition (cf. doc §7).
// Unicité (etab, produit, variante) renforcée par index partiels (rls.sql).

model ProductStock {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  variantId       String?  @map("variant_id") @db.Uuid
  etablissementId String   @map("etablissement_id") @db.Uuid
  quantite        Int      @default(0)
  quantiteMin     Int      @default(0) @map("quantite_min") // alerte si quantite <= quantiteMin
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  etablissement Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([etablissementId])
  @@index([productId])
  @@map("product_stock")
}

// ─────────────────── Dispatch / Transfert interne (Phase B) ───────────────────
// Déplacement formel de marchandise entrepôt → boutique : brouillon → validation.
// La validation déplace le stock des DEUX emplacements (ProductStock + mouvements).

enum DispatchStatus {
  DRAFT // créé, pas encore validé
  VALIDATED // validé — le stock a bougé
  CANCELLED // annulé avant validation
}

model DispatchOrder {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  sourceId      String         @map("source_id") @db.Uuid // établissement source (entrepôt)
  destinationId String         @map("destination_id") @db.Uuid // établissement destination (boutique)
  reference     String
  statut        DispatchStatus @default(DRAFT)
  note          String?
  createdBy     String         @map("created_by") @db.Uuid
  validatedBy   String?        @map("validated_by") @db.Uuid
  validatedAt   DateTime?      @map("validated_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source      Etablissement       @relation("DispatchSource", fields: [sourceId], references: [id])
  destination Etablissement       @relation("DispatchDestination", fields: [destinationId], references: [id])
  items       DispatchOrderItem[]

  @@index([tenantId])
  @@index([tenantId, statut])
  @@map("dispatch_orders")
}

model DispatchOrderItem {
  id              String  @id @default(uuid()) @db.Uuid
  tenantId        String  @map("tenant_id") @db.Uuid
  dispatchOrderId String  @map("dispatch_order_id") @db.Uuid
  productId       String  @map("product_id") @db.Uuid
  variantId       String? @map("variant_id") @db.Uuid
  quantite        Int

  dispatchOrder DispatchOrder @relation(fields: [dispatchOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])

  @@index([tenantId])
  @@index([dispatchOrderId])
  @@map("dispatch_order_items")
}

// ─────────────────── Notifications in-app (centre de pilotage) ───────────────────
// Alertes poussées au propriétaire/gérant (stock bas, impayé…). État de lecture au
// niveau entreprise (lu = traité par un admin). Dérivées des alertes déjà calculées.

enum NotificationType {
  STOCK_LOW // produit sous son seuil de réappro
  PAST_DUE // abonnement impayé
  SUPPLIER_DEBT // dette fournisseur
  INFO
}

model Notification {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  etablissementId String?          @map("etablissement_id") @db.Uuid
  type            NotificationType
  titre           String
  message         String
  /// Référence de l'entité concernée (ex: productId) — sert à la déduplication.
  entityId        String?          @map("entity_id")
  readAt          DateTime?        @map("read_at")
  createdAt       DateTime         @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, readAt])
  @@index([tenantId, type])
  @@map("notifications")
}
